{
  "name": "sillo",
  "displayName": "Sillo",
  "description": "IntelliSense, snippets and CLI shortcuts for the Sillo framework.",
  "version": "0.12.3",
  "publisher": "sillohq",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "sillo",
    "python",
    "web framework"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sillohq/vscode-sillo"
  },
  "main": "./out/extension.js",
  "contributes": {
    "snippets": [
      {
        "language": "python",
        "path": "./snippets/python.json"
      }
    ],
    "commands": [
      {
        "command": "sillo.configureProject",
        "title": "Sillo: Configure Project...",
        "category": "Sillo",
        "icon": "$(settings-gear)"
      },
      {
        "command": "sillo.runCommand",
        "title": "Sillo: Run CLI Command...",
        "category": "Sillo"
      },
      {
        "command": "sillo.listRoutes",
        "title": "Sillo: List Routes",
        "category": "Sillo"
      },
      {
        "command": "sillo.dbMake",
        "title": "Sillo: Make Migration (db:make)",
        "category": "Sillo"
      },
      {
        "command": "sillo.dbMigrate",
        "title": "Sillo: Run Migrations (db:migrate)",
        "category": "Sillo"
      },
      {
        "command": "sillo.dbStatus",
        "title": "Sillo: Migration Status (db:status)",
        "category": "Sillo"
      },
      {
        "command": "sillo.dbRollback",
        "title": "Sillo: Rollback Migration (db:rollback)",
        "category": "Sillo"
      },
      {
        "command": "sillo.queueWork",
        "title": "Sillo: Start Queue Worker (queue:work)",
        "category": "Sillo"
      },
      {
        "command": "sillo.previewApplication",
        "title": "Sillo: Preview Application",
        "category": "Sillo"
      },
      {
        "command": "sillo.openApiDocs",
        "title": "Sillo: Open API Docs",
        "category": "Sillo"
      },
      {
        "command": "sillo.newMiddleware",
        "title": "Sillo: New Middleware...",
        "category": "Sillo"
      },
      {
        "command": "sillo.createApp",
        "title": "Sillo: Create Sillo App...",
        "category": "Sillo"
      },
      {
        "command": "sillo.runRoute",
        "title": "Sillo: Run Route Request",
        "category": "Sillo"
      },
      {
        "command": "sillo.refreshStructure",
        "title": "Sillo: Refresh Application Structure",
        "category": "Sillo",
        "icon": "$(refresh)"
      },
      {
        "command": "sillo.openRouteDefinition",
        "title": "Sillo: Open Route Definition",
        "category": "Sillo",
        "icon": "$(go-to-file)"
      },
      {
        "command": "sillo.runRouteFromTree",
        "title": "Sillo: Try Request",
        "category": "Sillo",
        "icon": "$(play)"
      },
      {
        "command": "sillo.viewModelData",
        "title": "Sillo: View Table Data",
        "category": "Sillo",
        "icon": "$(table)"
      },
      {
        "command": "sillo.showBestPractices",
        "title": "Sillo: Show Best Practices",
        "category": "Sillo"
      }
    ],
    "configuration": {
      "title": "Sillo",
      "properties": {
        "sillo.cliCommand": {
          "type": "string",
          "default": "sillo",
          "description": "The command used to invoke the Sillo CLI (e.g. \"sillo\", \"uv run sillo\")."
        },
        "sillo.createAppCommand": {
          "type": "string",
          "default": "uvx sillo-start",
          "description": "The command used to scaffold a new Sillo app (runs \"<this> create-app <name>\")."
        },
        "sillo.devServerCommand": {
          "type": "string",
          "default": "uvicorn app.main:app --reload",
          "description": "The command used to run the app for \"Sillo: Preview Application\". Leave unset (this default is only a last resort) to auto-detect from [tool.sillo] app / the app.main:app-style guesses in pyproject.toml, plus HOST/PORT from .env."
        },
        "sillo.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "Base URL the app is served on. Leave unset (this default is only a last resort) to auto-detect HOST/PORT from the project's .env or app/config.py."
        },
        "sillo.docsPath": {
          "type": "string",
          "default": "/docs",
          "description": "Path the app serves its OpenAPI/Swagger UI on, for \"Sillo: Open API Docs\"."
        },
        "sillo.databasePath": {
          "type": "string",
          "default": "",
          "description": "Path to the project's SQLite database, for the DB viewer. Absolute, or relative to the project's pyproject.toml directory. Only needed when auto-detection (reading sqlite:// out of .env / app/config.py, or finding a single *.db/*.sqlite file under storage/) doesn't find it."
        },
        "sillo.databaseUrl": {
          "type": "string",
          "default": "",
          "description": "Full sqlite:// or postgres:// connection URL for the DB viewer, checked before sillo.databasePath and before auto-detection. Use this for Postgres, or when the DATABASE_URL auto-detection reads isn't the one you actually want the viewer to open."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
